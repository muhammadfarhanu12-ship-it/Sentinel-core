# Sentinel-Core frontend configuration
# VITE_API_BASE_URL may be either the backend origin or the /api/v1 base URL.
VITE_API_BASE_URL=https://sentinel-core-xcrz.onrender.com
VITE_API_URL=https://sentinel-core-xcrz.onrender.com
VITE_API_WS_URL=wss://sentinel-core-xcrz.onrender.com

# Separate admin app origin used by /admin redirects from the user dashboard.
VITE_ADMIN_APP_ORIGIN=https://sentinel-admin-beta.vercel.app

# Optional dedicated admin API base. Defaults to <backend-origin>/api/v1/admin.
VITE_ADMIN_API_BASE_URL=https://sentinel-core-xcrz.onrender.com/api/v1/admin
