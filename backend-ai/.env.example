# Sentinel-Core AI Gateway backend configuration
# Copy this file to .env and replace every placeholder before production use.

# Required core runtime
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/sentinel
MONGO_DB_NAME=sentinel_dashboard
JWT_SECRET=replace_with_strong_random_secret
API_KEY_SECRET=replace_with_strong_random_secret

# Public URLs and CORS
CORS_ORIGINS=https://your-frontend.vercel.app
# ALLOWED_ORIGINS is also supported as an alias for CORS_ORIGINS.
FRONTEND_URL=https://your-frontend.vercel.app
ADMIN_FRONTEND_URL=https://your-admin.vercel.app
BACKEND_PUBLIC_URL=https://your-backend.onrender.com

# Auth/session behavior
APP_ENV=development
JWT_ALGORITHM=HS256
JWT_ISSUER=sentinelcore
JWT_AUDIENCE=sentinelcore-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=30
AUTH_DEBUG_TOKEN_LOGGING=false
AUTH_TEST_FLOW_ENABLED=false
BLOCKED_EMAIL_DOMAINS=

# Optional bootstrap admin. Set both values or leave both blank.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_LOGIN_ALERT_EMAIL=

# AI providers
AI_PROVIDER=gemini
FALLBACK_AI_PROVIDER=openai
AI_PROVIDER_TIMEOUT_SECONDS=30
GEMINI_API_KEY=example_gemini_key_replace_me
OPENAI_API_KEY=example_openai_key_replace_me

# Security and request limits
LOG_LEVEL=INFO
MAX_REQUEST_SIZE_BYTES=1048576
MAX_UPLOAD_SIZE_BYTES=5242880
ALLOWED_UPLOAD_TYPES=text/plain,application/json,text/csv,application/pdf,application/xml
ALLOWED_FILE_EXTENSIONS=.txt,.json,.csv,.pdf,.xml
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Sentinel enforcement
SENTINEL_RISK_THRESHOLD=70
SENTINEL_MAX_DECODE_DEPTH=3
SENTINEL_MAX_DECODE_PAYLOAD_CHARS=24000
SENTINEL_DECODE_TIMEOUT_MS=400
SENTINEL_REQUIRE_2FA_FOR_SENSITIVE_TOOLS=true
SENTINEL_ENABLE_2FA_ENFORCEMENT=true
SENTINEL_2FA_STATIC_CODE=
SENTINEL_2FA_ALLOW_DEMO_BYPASS=false

# SMTP/remediation. Fill all SMTP values if email delivery is enabled.
REMEDIATION_ENABLED=true
REMEDIATION_THREAT_SCORE_THRESHOLD=0.9
REMEDIATION_EMAIL_ENABLED=true
REMEDIATION_EMAIL_FROM=
REMEDIATION_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=example_smtp_password_replace_me
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_VERIFY_ON_STARTUP=false
REMEDIATION_WEBHOOK_URLS=
REMEDIATION_WEBHOOK_TIMEOUT_SECONDS=3

# Billing placeholders
STRIPE_SECRET_KEY=example_stripe_secret_replace_me
STRIPE_WEBHOOK_SECRET=example_stripe_webhook_secret_replace_me
STRIPE_PRICE_PRO=price_pro_replace_me
STRIPE_PRICE_BUSINESS=price_business_replace_me
